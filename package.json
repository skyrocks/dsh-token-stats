{
  "name": "@skyrocks/dsh-token-stats",
  "version": "0.1.1",
  "description": "DeepSeek Harness plugin: 在设置里按日 / 周 / 月统计所有会话的 token 消耗（输入、缓存、输出、调用次数与模型分布）",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./typert": "./typert.host.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "service.js",
    "accountant.js",
    "ledger.js",
    "options.js",
    "store.js",
    "client.js",
    "typert.host.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "icon.svg",
    "docs",
    "locale/*.json"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.2"
  },
  "author": "skyrocks (https://github.com/skyrocks)",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "tokens",
    "usage",
    "statistics"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/accountant.mjs && node test/client.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skyrocks/dsh-token-stats.git"
  },
  "homepage": "https://github.com/skyrocks/dsh-token-stats#readme",
  "bugs": {
    "url": "https://github.com/skyrocks/dsh-token-stats/issues"
  }
}
